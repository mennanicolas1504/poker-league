rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Qualquer pessoa pode ler a classificação e as etapas (site público).
    // Só quem está autenticado (login anônimo automático, feito pelo app.js)
    // pode criar/editar/apagar — isso barra robôs que não rodam o site,
    // mas não substitui uma senha de verdade. É um nível de proteção
    // pensado para um campeonato entre amigos, não para um site público
    // aberto ao mundo todo.

    match /etapas/{etapaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
